    },
    "Lies on a narrow side. The best side there is.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тар қырымен тұрады. Ең жақсы жағы."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лежит на узком боку. Лучшая сторона."
          }
        }
      }
    },
    "Lies on its hollow back, the hollow up. The lowest.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ойығы жоғары қарап жатады. Ең төменгісі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лежит выемкой вверх. Самая младшая."
          }
        }
      }
    },
    "Lies on its rounded back. Third.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дөңес арқасы жоғары қарап жатады. Үшінші."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лежит выпуклой спинкой вверх. Третья."
          }
        }
      }
    },
    "Lies on the other narrow side. Second best.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екінші тар қырымен тұрады. Екінші орында."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лежит на другом узком боку. Вторая по старшинству."
          }
        }
      }
    },
