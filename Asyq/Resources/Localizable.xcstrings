{
  "sourceLanguage": "en",
  "strings": {
    "%@ Flick the screen to spin yours.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Сақаңды иіру үшін экранды саусақпен сілте."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Смахни по экрану, чтобы закрутить свою."
          }
        }
      }
    },
    "%@ In a match your rival would throw now — here, just try again.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Матчта енді қарсылас атар еді — мұнда тағы бір байқап көр."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ В матче сейчас бросал бы соперник — а здесь просто попробуй ещё раз."
          }
        }
      }
    },
    "%@ Pull a little harder, so the saqa flies into the circle.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Сақа шеңберге ұшып кіруі үшін сәл қаттырақ тарт."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Натяни чуть сильнее, чтобы сақа влетела в круг по воздуху."
          }
        }
      }
    },
    "%@ The higher side throws first.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Жоғары жағымен түскен бірінші атады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Чья сторона старше, тот бросает первым."
          }
        }
      }
    },
    "%@ is aiming": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ көздеп жатыр"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ целится"
          }
        }
      }
    },
    "%@ spins…": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ иіріп жатыр…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ крутит…"
          }
        }
      }
    },
    "%@ won it": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ кезеңді ұтты"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ выиграл партию"
          }
        }
      }
    },
    "%@ won the match": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ матчта жеңді"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ выиграл матч"
          }
        }
      }
    },
    "%@ · %lld kenei · %@": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld кеней · %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld кенеев · %3$@"
          }
        }
      }
    },
    "%@ — “%@”": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — «%2$@»"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — «%2$@»"
          }
        }
      }
    },
    "%@, ages %@": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, жасы %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, возраст %2$@"
          }
        }
      }
    },
    "%@: %lld, partias %lld": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld, кезеңдер %3$lld"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld, партий %3$lld"
          }
        }
      }
    },
    "%@’s side is higher — they start": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ жоғары жағымен түсті — ол бастайды"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сторона у %@ старше — начинает соперник"
          }
        }
      }
    },
    "%@’s throw": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ атады"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бросает %@"
          }
        }
      }
    },
    "%lld of %lld knocked out": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld кенейдің %1$lld-і шықты"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбито %1$lld из %2$lld"
          }
        }
      }
    },
    "A kenei crossed the circle line: it's yours, and you throw again, closer, from the circle's edge.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кеней шеңбер сызығынан шықты: ол сенікі, енді тағы атасың — жақынырақ, шеңбердің шетінен."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кеней пересёк линию круга: он твой, и ты бросаешь снова — ближе, с края круга."
          }
        }
      }
    },
    "A saqa weighs 28–30 g, a kenei 15–17 g: the heavier bone does the knocking.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сақаның салмағы 28–30 г, кенейдікі 15–17 г: ауыр асық ұрады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сақа весит 28–30 г, кеней — 15–17 г: бьёт кость потяжелее."
          }
        }
      }
    },
    "Adults": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ересек"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взрослые"
          }
        }
      }
    },
    "Again — now from the circle's edge": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тағы да — енді шеңбердің шетінен"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё раз — теперь с края круга"
          }
        }
      }
    },
    "Ages %@": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жасы %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возраст %@"
          }
        }
      }
    },
    "Alshy": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алшы"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Алшы"
          }
        }
      }
    },
    "Alshy beats taike, taike beats buk, buk beats shik": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алшы тәйкеден, тәйке бүктен, бүк шіктен жоғары"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Алшы старше тәйке, тәйке старше бүк, бүк старше шік"
          }
        }
      }
    },
    "As long as you knock kenei out, you keep throwing. That's your series.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кенейді шығарып тұрсаң, ата бересің. Бұл — сенің серияң."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока выбиваешь кенеи, ты продолжаешь бросать. Это твоя серия."
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Артқа"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назад"
          }
        }
      }
    },
    "Before a match both players spin their saqa onto the carpet. Whoever lands the higher side throws first.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Матч алдында екі ойыншы да сақасын кілемге иіреді. Кімнің сақасы жоғары жағымен түссе, сол бірінші атады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед матчем оба игрока крутят сақу на ковёр. Чья ляжет старшей стороной, тот бросает первым."
          }
        }
      }
    },
    "Bones and field": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Асықтар мен алаң"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кости и поле"
          }
        }
      }
    },
    "Buk": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүк"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүк"
          }
        }
      }
    },
    "Circle %@": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шеңбер %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Круг %@"
          }
        }
      }
    },
    "Circle %@, throw from %@": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шеңбер %1$@, ату қашықтығы %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Круг %1$@, бросок с %2$@"
          }
        }
      }
    },
    "Defeat": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жеңіліс"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поражение"
          }
        }
      }
    },
    "Diagonal": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагональ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагональ"
          }
        }
      }
    },
    "Diagonal!": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагональ!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагональ!"
          }
        }
      }
    },
    "Diagram of the field seen from above: a circle with the kon of kenei across its middle, and a throw line on each side.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алаңның жоғарыдан көрінісі: шеңбер, ортасында кенейлер тігілген көн, екі жағында ату сызықтары."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Схема поля сверху: круг, посередине кон из кенеев, по обе стороны — линии броска."
          }
        }
      }
    },
    "Diagram of the field: the circle with the kon in the middle.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алаң сызбасы: ортасында көні бар шеңбер."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Схема поля: круг с коном посередине."
          }
        }
      }
    },
    "Diagram: the kenei lies between the kon and the circle. The thrower stands on the opposite side of the circle and throws across the kon at it.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сызба: кеней көн мен шеңбердің арасында жатыр. Ойыншы шеңбердің қарсы жағына тұрып, көннің үстінен атады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Схема: кеней лежит между коном и кругом. Игрок встаёт с противоположной стороны круга и бьёт по нему через кон."
          }
        }
      }
    },
    "Diagram: the kenei lies between the parallel lines. The thrower stands on the circle's wing, in line with the kon, and throws along the lines at it.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сызба: кеней параллель сызықтардың арасында жатыр. Ойыншы шеңбердің қанатына, көн бойына тұрып, сызықтарды бойлай атады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Схема: кеней лежит между параллельными линиями. Игрок встаёт на «крыло» круга на оси кона и бьёт вдоль линий."
          }
        }
      }
    },
    "Diagram: the kenei lies just inside the circle line. The thrower stands five feet along the circle from it, on either side, and throws at it.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сызба: кеней шеңбер сызығының дәл ішінде жатыр. Ойыншы шеңбер бойымен кез келген жаққа бес табан санап, соны атады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Схема: кеней лежит у самой линии круга. Игрок отмеряет пять стоп вдоль круга в любую сторону и бьёт по нему."
          }
        }
      }
    },
    "Federation rules: knock the bones out of the circle — first to %lld of %lld wins the round": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Федерация ережесі: асықтарды шеңберден шығар — %2$lld асықтың %1$lld-ін бірінші шығарған кезеңді ұтады"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила федерации: выбей кости из круга — кто первым выбьет %1$lld из %2$lld, выигрывает партию"
          }
        }
      }
    },
    "First to %lld of %lld": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірінші болып %1$lld/%2$lld"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первым %1$lld из %2$lld"
          }
        }
      }
    },
    "Five feet": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бес табан"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пять стоп"
          }
        }
      }
    },
    "Five feet!": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бес табан!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пять стоп!"
          }
        }
      }
    },
    "From the best side to the lowest:": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ең жақсы жағынан ең төменгісіне дейін:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От лучшей стороны к младшей:"
          }
        }
      }
    },
    "Got it": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Түсінікті"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Понятно"
          }
        }
      }
    },
    "How a turn goes": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кезек қалай өтеді"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как идёт ход"
          }
        }
      }
    },
    "How to play": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалай ойнайды"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как играть"
          }
        }
      }
    },
    "How to win": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалай жеңеді"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как выиграть"
          }
        }
      }
    },
    "If your saqa hits a kenei that stays inside the circle, the referee gives you one more throw at it, from a new spot:": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сақаң тиген кеней шеңбер ішінде қалса, төреші оны жаңа жерден тағы бір рет атуға рұқсат береді:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если сақа задела кеней, а он остался в круге, судья даёт ещё один бросок по нему с новой точки:"
          }
        }
      }
    },
    "Juniors": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жасөспірім"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подростки"
          }
        }
      }
    },
    "Kazakh knucklebones": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "асық ату"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "асык ату"
          }
        }
      }
    },
    "Kids": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бала"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дети"
          }
        }
      }
    },
    "Knock a kenei out of the circle": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кенейді шеңберден шығар"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбей кеней из круга"
          }
        }
      }
    },
    "Knock out %lld of the %lld kenei first to win a round — adults play to 8 of 15. Win two rounds to win the match.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld кенейдің %1$lld-ін бірінші шығарсаң, кезеңді ұтасың — ересектер 15-тен 8-ге дейін ойнайды. Екі кезеңді ұтсаң, матч сенікі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбей первым %1$lld из %2$lld кенеев, чтобы выиграть партию, — взрослые играют до 8 из 15. Две партии — и матч твой."
          }
        }
      }
    },
    "Knock out %lld of the %lld kenei first to win the round. Win two rounds to win the match.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld кенейдің %1$lld-ін бірінші шығар — кезең сенікі. Екі кезеңді ұтсаң, матч сенікі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбей первым %1$lld из %2$lld кенеев — и партия твоя. Две партии — и матч твой."
          }
        }
      }
    },
