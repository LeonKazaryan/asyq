    "Standing on an end: no rank, spin again.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ұшымен тұр: дәрежесі жоқ, қайта иіреді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоит на торце: без ранга, перебрасывают."
          }
        }
      }
    },
    "Stands upright on one end. Rare, and outside the ranking.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір ұшымен тік тұрады. Сирек кездеседі, дәрежеден тыс."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоит вертикально на одном торце. Редко и вне ранга."
          }
        }
      }
    },
    "Stands upright on the other end. Rare, and outside the ranking.": {
      "localizations": {
